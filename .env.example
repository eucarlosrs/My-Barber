# =============================================================================
# MY BARBER — CONFIGURAÇÃO MULTIAMBIENTE (.env.example)
# =============================================================================

# 1. AMBIENTE DE EXECUÇÃO
# APP_ENV: Define o ambiente da aplicação ('development' | 'sandbox' | 'production')
APP_ENV="development"
# VITE_APP_ENV: Espelho do ambiente para o frontend React
VITE_APP_ENV="development"

# 2. IA & APLICAÇÃO GERAL
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL: The URL where this applet is hosted (Cloud Run URL)
APP_URL="MY_APP_URL"

# 3. FIREBASE — CONFIGURAÇÃO CLIENT-SIDE (SDK WEB)
# Quando APP_ENV=sandbox, estas variáveis são obrigatórias para isolamento total:
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# 4. FIREBASE — CONFIGURAÇÃO BACKEND (ADMIN SDK)
# Quando APP_ENV=sandbox, estas variáveis são obrigatórias para o backend isolado:
FIREBASE_PROJECT_ID=""
FIRESTORE_DATABASE_ID=""
FIREBASE_STORAGE_BUCKET=""
# FIREBASE_SERVICE_ACCOUNT: JSON da Service Account do projeto Sandbox (opcional em Cloud Run)
FIREBASE_SERVICE_ACCOUNT=""

# 5. FIREBASE APP CHECK & RECAPTCHA
VITE_RECAPTCHA_SITE_KEY=""
VITE_APPCHECK_DEBUG_TOKEN=""

# 6. MERCADO PAGO — GATEWAY FINANCEIRO
# Em APP_ENV=sandbox, exige obrigatoriamente credenciais com prefixo TEST-...
# Em APP_ENV=production, proíbe expressamente credenciais de teste
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""
MERCADOPAGO_COLLECTOR_ID=""

