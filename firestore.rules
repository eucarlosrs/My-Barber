rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------
    // HELPER FUNCTIONS & AUTHENTICATION
    // ----------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'carlosrs.email@gmail.com' ||
        request.auth.token.role == 'SUPER_ADMIN' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN'
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwnerOfTenant(tenantId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData().tenantId == tenantId && getUserData().role == 'PROPRIETARIO')
      );
    }

    function isManagerOrOwnerOfTenant(tenantId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData().tenantId == tenantId && (getUserData().role == 'PROPRIETARIO' || getUserData().role == 'GERENTE'))
      );
    }

    function isProfessionalOfTenant(tenantId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData().tenantId == tenantId && getUserData().role == 'PROFISSIONAL')
      );
    }

    function isMemberOfTenant(tenantId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getUserData().tenantId == tenantId
      );
    }

    // ----------------------------------------------------
    // 1. BARBERSHOPS (TENANTS)
    // ----------------------------------------------------
    match /barbershops/{barbershopId} {
      // Leitura e atualização de dados da barbearia (fotos, logo, banner, configurações)
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin() || isAuthenticated();
    }

    // ----------------------------------------------------
    // 2. USERS (USUÁRIOS, FOTOS DE PERFIL E EQUIPE)
    // ----------------------------------------------------
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // ----------------------------------------------------
    // 3. SERVICES (SERVIÇOS E FOTOS DOS CORTES)
    // ----------------------------------------------------
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ----------------------------------------------------
    // 4. SCHEDULES (HORÁRIOS DOS PROFISSIONAIS)
    // ----------------------------------------------------
    match /schedules/{scheduleId} {
      allow read: if true; // Leitura pública dos horários disponíveis
      allow create, update: if isSuperAdmin() || (
        isAuthenticated() && (
          isManagerOrOwnerOfTenant(request.resource.data.tenantId || resource.data.tenantId) ||
          request.auth.uid == request.resource.data.professionalId ||
          request.auth.uid == resource.data.professionalId
        )
      );
      allow delete: if isSuperAdmin() || isManagerOrOwnerOfTenant(resource.data.tenantId);
    }

    // ----------------------------------------------------
    // 5. APPOINTMENTS (AGENDAMENTOS)
    // ----------------------------------------------------
    match /appointments/{appointmentId} {
      // Leitura pública necessária para checagem de slots e exibição de horários ocupados/histórico
      allow read: if true;

      // Criação e atualização de agendamentos por clientes e profissionais
      allow create, update: if true;

      // Exclusão restrita à gestão da barbearia ou Super Admin
      allow delete: if isSuperAdmin() || isManagerOrOwnerOfTenant(resource.data.tenantId) || isAuthenticated();
    }

    // ----------------------------------------------------
    // 6. PACKAGES & CUSTOMER PACKAGES
    // ----------------------------------------------------
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isManagerOrOwnerOfTenant(request.resource.data.tenantId || resource.data.tenantId);
    }

    match /customerPackages/{cpId} {
      allow read: if true;
      allow write: if true;
    }

    // ----------------------------------------------------
    // 7. WAITLIST (FILA DE ESPERA)
    // ----------------------------------------------------
    match /waitlist/{entryId} {
      allow read, write: if true;
    }

    // ----------------------------------------------------
    // 8. RAFFLES, PROMOTIONS & COMMUNICATIONS
    // ----------------------------------------------------
    match /raffles/{raffleId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isManagerOrOwnerOfTenant(request.resource.data.tenantId || resource.data.tenantId);
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isManagerOrOwnerOfTenant(request.resource.data.tenantId || resource.data.tenantId);
    }

    match /communications/{commId} {
      allow read, write: if isSuperAdmin() || isManagerOrOwnerOfTenant(request.resource.data.tenantId || resource.data.tenantId);
    }

    match /returnMessages/{msgId} {
      allow read, write: if isSuperAdmin() || isManagerOrOwnerOfTenant(request.resource.data.tenantId || resource.data.tenantId);
    }

    match /stock/{stockId} {
      allow read, write: if isSuperAdmin() || isManagerOrOwnerOfTenant(request.resource.data.tenantId || resource.data.tenantId);
    }

    // ----------------------------------------------------
    // 9. GALLERY & STORIES
    // ----------------------------------------------------
    match /gallery/{workId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isMemberOfTenant(request.resource.data.tenantId || resource.data.tenantId);
    }

    match /stories/{storyId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isManagerOrOwnerOfTenant(request.resource.data.tenantId || resource.data.tenantId);
    }

    // ----------------------------------------------------
    // 10. AUDIT LOGS (EXCLUSIVO MASTER / SUPER ADMIN)
    // ----------------------------------------------------
    match /audit_logs/{logId} {
      // Leitura e gerenciamento estritamente restritos ao Master Admin da plataforma
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if false; // Logs de auditoria são imutáveis
    }

    // ----------------------------------------------------
    // 11. ASSINATURAS MERCADO PAGO (SUBSCRIPTIONS)
    // ----------------------------------------------------
    match /subscriptions/{subscriptionId} {
      // Leitura: Super Admin ou Proprietário da respectiva barbearia
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.barbershopId == getUserData().tenantId
        )
      );
      // Escrita financeira direta pelo cliente é bloqueada (gerenciado pelo Backend / Admin SDK)
      allow write: if isSuperAdmin();
    }

    // ----------------------------------------------------
    // 12. HISTÓRICO DE PAGAMENTOS (SUBSCRIPTION PAYMENTS)
    // ----------------------------------------------------
    match /subscription_payments/{paymentId} {
      // Leitura: Super Admin ou Proprietário da respectiva barbearia
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.barbershopId == getUserData().tenantId
        )
      );
      // Escrita estritamente via Backend / Admin SDK / Super Admin
      allow write: if isSuperAdmin();
    }

    // ----------------------------------------------------
    // 13. WEBHOOK EVENTS LOGS
    // ----------------------------------------------------
    match /webhook_events/{eventId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }
  }
}

